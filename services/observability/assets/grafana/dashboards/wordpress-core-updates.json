    {
      "datasource": "Prometheus",
      "description": "Versions are read from each deployment's wp-includes/version.php on disk, rather than inferred from the Docker image tag.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": null,
            "displayMode": "auto",
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
