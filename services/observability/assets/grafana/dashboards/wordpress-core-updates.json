      "options": {
        "showHeader": true
      },
      "pluginVersion": "7.3.6",
      "targets": [
        {
          "expr": "wordpress_core_version_info{job=\"ax51\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Installed core version by deployment",
      "type": "table"
    },
    {
      "datasource": "Prometheus",
      "description": "A value of 1 means the installed version is older than the latest stable release from the WordPress.org release feed.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": null,
            "displayMode": "auto",
            "filterable": true
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "text": "Current"
                },
                "1": {
                  "color": "red",
                  "text": "Update pending"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 5,
      "options": {
        "showHeader": true
      },
      "pluginVersion": "7.3.6",
      "targets": [
        {
          "expr": "wordpress_core_update_available{job=\"ax51\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Core update status",
      "type": "table"
    },
    {
      "datasource": "Prometheus",
      "description": "Delay is the WordPress.org release publication time to the first exporter observation of that installed version. The initial observation is a baseline; rollout delay appears after the next observed version change. Collection runs every five minutes, so rollout timing is approximate to that interval.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": null,
            "displayMode": "auto",
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 6,
      "options": {
        "showHeader": true
      },
      "pluginVersion": "7.3.6",
      "targets": [
        {
          "expr": "wordpress_core_rollout_delay_seconds{job=\"ax51\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Last observed release-to-rollout delay",
      "type": "table"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": null,
            "displayMode": "auto",
