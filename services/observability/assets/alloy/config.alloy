logging {
	level  = "info"
	format = "logfmt"
}

prometheus.remote_write "mimir" {
	endpoint {
		url = "MIMIR_PUSH_URL"
	}
}

loki.write "loki" {
	endpoint {
		url = "LOKI_PUSH_URL"
	}
}

// ---------------------------------------------------------------------------
// Cluster components
// ---------------------------------------------------------------------------

// The API server's histograms alone were 66,000 of its 82,700 series (2026-10-17) and used up most
// of Mimir's per-tenant limit of 150,000 active series. Nothing here uses them, so the buckets are
// dropped; `_count`, `_sum` and `apiserver_request_total` stay. Keep a bucket back if a latency
// panel needs `histogram_quantile`.
prometheus.relabel "apiserver" {
	forward_to = [prometheus.remote_write.mimir.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = ".+_bucket"
		action        = "drop"
	}
}

prometheus.scrape "apiserver" {
	targets = [{"__address__" = "kubernetes.default.svc:443"}]

	forward_to        = [prometheus.relabel.apiserver.receiver]
	job_name          = "apiserver"
	scheme            = "https"
	scrape_interval   = "30s"
	scrape_timeout    = "10s"
	bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

	tls_config {
		ca_file     = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
		server_name = "kubernetes.default.svc"
	}
}

// Kubelet, resource and cAdvisor metrics are read through the API server's node proxy.
discovery.kubernetes "nodes" {
	role = "node"
}

discovery.relabel "kubelet" {
	targets = discovery.kubernetes.nodes.targets

	rule {
		source_labels = ["__meta_kubernetes_node_name"]
		target_label  = "node"
	}

	rule {
		source_labels = ["__meta_kubernetes_node_name"]
		target_label  = "instance"
	}

	rule {
		replacement  = "kubernetes.default.svc:443"
		target_label = "__address__"
	}
}

discovery.relabel "kubelet_metrics" {
	targets = discovery.relabel.kubelet.output

	rule {
		replacement  = "kubelet"
		target_label = "job"
	}

	rule {
		source_labels = ["__meta_kubernetes_node_name"]
		replacement   = "/api/v1/nodes/$1/proxy/metrics"
		target_label  = "__metrics_path__"
	}
}

discovery.relabel "kubelet_cadvisor" {
	targets = discovery.relabel.kubelet.output

	rule {
		replacement  = "cadvisor"
		target_label = "job"
	}

	rule {
		source_labels = ["__meta_kubernetes_node_name"]
		replacement   = "/api/v1/nodes/$1/proxy/metrics/cadvisor"
		target_label  = "__metrics_path__"
	}
}

prometheus.scrape "kubelet" {
	targets           = discovery.relabel.kubelet_metrics.output
	forward_to        = [prometheus.remote_write.mimir.receiver]
	scheme            = "https"
	scrape_interval   = "30s"
	scrape_timeout    = "10s"
	bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

	tls_config {
		ca_file     = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
		server_name = "kubernetes.default.svc"
	}
}

prometheus.scrape "cadvisor" {
	targets           = discovery.relabel.kubelet_cadvisor.output
	forward_to        = [prometheus.remote_write.mimir.receiver]
	scheme            = "https"
	scrape_interval   = "30s"
	scrape_timeout    = "10s"
	bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

	tls_config {
		ca_file     = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
		server_name = "kubernetes.default.svc"
	}
}

// ---------------------------------------------------------------------------
// Pods exposing metrics on a conventionally named container port: node-exporter,
// CloudNativePG, cert-manager, Traefik, MetalLB, CoreDNS, Longhorn, Loki, Mimir and Alloy itself.
// ---------------------------------------------------------------------------

discovery.kubernetes "pods" {
	role = "pod"
}

discovery.relabel "metrics_pods" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_container_port_name", "__meta_kubernetes_pod_phase"]
		regex         = "(metrics|http-metrics|monitoring|manager);Running"
		action        = "keep"
	}

	// The nginx gateways of Loki and Mimir name their proxy port `http-metrics`, but serve no metrics.
	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		regex         = "gateway|nginx"
		action        = "drop"
	}

	// Trivy is scraped separately below so only the bounded vulnerability summary metric is sent.
	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		regex         = "trivy-operator"
		action        = "drop"
	}
	// Wazuh exporters are scraped explicitly through allow-lists below; avoid their broad default metrics.
	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		regex         = "wazuh"
		action        = "drop"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		regex         = "(.+)"
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app"]
		regex         = "(.+)"
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_k8s_app"]
		regex         = "(.+)"
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_cnpg_io_cluster"]
		regex         = "(.+)"
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace", "app"]
		separator     = "/"
		target_label  = "job"
	}
}

prometheus.scrape "metrics_pods" {
	targets         = discovery.relabel.metrics_pods.output
	forward_to      = [prometheus.remote_write.mimir.receiver]
	scrape_interval = "30s"
	scrape_timeout  = "10s"
}

// kube-state-metrics names its container port `http`, which is too generic to match above.
discovery.relabel "kube_state_metrics" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_container_port_name"]
		regex         = "kube-state-metrics;http"
		action        = "keep"
	}

	// No pod or namespace labels here: the series carry the labels of the objects they describe,
	// and a target label of the same name would turn them into `exported_*`.
	rule {
		replacement  = "kube-state-metrics"
		target_label = "job"
	}
}

prometheus.scrape "kube_state_metrics" {
	targets         = discovery.relabel.kube_state_metrics.output
	forward_to      = [prometheus.remote_write.mimir.receiver]
	scrape_interval = "30s"
	scrape_timeout  = "10s"
}

// Grafana serves /metrics on its `grafana` container port.
discovery.relabel "grafana" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_container_port_name"]
		regex         = "grafana;grafana"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		replacement  = "grafana"
		target_label = "job"
	}
}

prometheus.scrape "grafana" {
	targets         = discovery.relabel.grafana.output
	forward_to      = [prometheus.remote_write.mimir.receiver]
	scrape_interval = "30s"
	scrape_timeout  = "10s"
}

// Vulnerability summary only; omitting the per-CVE metric avoids unbounded label cardinality.
prometheus.relabel "trivy_operator" {
	forward_to = [prometheus.remote_write.mimir.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "^(trivy_image_vulnerabilities|up)$"
		action        = "keep"
	}
}

prometheus.scrape "trivy_operator" {
	targets = [{
		// The service is headless, so use the endpoint port rather than its 80/TCP service port.
		"__address__" = "trivy-operator.trivy-operator.svc:8080",
	}]

	forward_to      = [prometheus.relabel.trivy_operator.receiver]
	job_name        = "trivy-operator"
	scrape_interval = "60s"
	scrape_timeout  = "10s"
}
// Wazuh exporters are scraped explicitly so their high-cardinality default output never reaches
// Mimir. Index stats are restricted to the two wazuh-* families and aggregated in queries.
prometheus.relabel "wazuh_indexer" {
	forward_to = [prometheus.remote_write.mimir.receiver]

	rule {
		source_labels = ["__name__", "index", "area"]
		regex         = "^(up;;|elasticsearch_cluster_health_(status|number_of_nodes|active_shards|unassigned_shards);;|elasticsearch_indices_(store_size_bytes_total|docs_total);wazuh-.*;|elasticsearch_jvm_memory_(used|max)_bytes;;heap|elasticsearch_filesystem_data_(available|size)_bytes;;)$"
		action        = "keep"
	}
}

prometheus.scrape "wazuh_indexer" {
	targets = [{
		"__address__" = "wazuh-indexer-exporter.wazuh.svc:9114",
	}]

	forward_to      = [prometheus.relabel.wazuh_indexer.receiver]
	job_name        = "wazuh-indexer"
	scrape_interval = "60s"
	scrape_timeout  = "15s"
}

// The findings exporter probes OpenSearch. Keep the bounded aggregates only.
prometheus.relabel "wazuh_findings" {
	forward_to = [prometheus.remote_write.mimir.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "^(up|wazuh_agent_status_count|wazuh_high_level_events|wazuh_vulnerability_findings_by_(severity|agent)_count|wazuh_vulnerability_fixable_findings_(critical|high))$"
		action        = "keep"
	}
}

prometheus.scrape "wazuh_agent_status" {
	targets = [{
		"__address__"      = "wazuh-findings-exporter.wazuh.svc:7979",
		"__metrics_path__" = "/probe",
		"__param_module"   = "wazuh_agent_status",
		"__param_target"   = "https://wazuh-indexer.wazuh.svc:9200/wazuh-monitoring-*/_search",
	}]

	forward_to      = [prometheus.relabel.wazuh_findings.receiver]
	job_name        = "wazuh-agent-status"
	scrape_interval = "60s"
	scrape_timeout  = "15s"
}

prometheus.scrape "wazuh_vulnerabilities" {
	targets = [{
		"__address__"      = "wazuh-findings-exporter.wazuh.svc:7979",
		"__metrics_path__" = "/probe",
		"__param_module"   = "wazuh_vulnerabilities",
		"__param_target"   = "https://wazuh-indexer.wazuh.svc:9200/wazuh-states-vulnerabilities-*/_search",
	}]

	forward_to      = [prometheus.relabel.wazuh_findings.receiver]
	job_name        = "wazuh-vulnerabilities"
	scrape_interval = "60s"
	scrape_timeout  = "15s"
}

prometheus.scrape "wazuh_vulnerabilities_fixable" {
	targets = [{
		"__address__"      = "wazuh-findings-exporter.wazuh.svc:7979",
		"__metrics_path__" = "/probe",
		"__param_module"   = "wazuh_vulnerabilities_fixable",
		"__param_target"   = "https://wazuh-indexer.wazuh.svc:9200/wazuh-states-vulnerabilities-*/_search",
	}]

	forward_to      = [prometheus.relabel.wazuh_findings.receiver]
	job_name        = "wazuh-vulnerabilities-fixable"
	scrape_interval = "60s"
	scrape_timeout  = "15s"
}

prometheus.scrape "wazuh_high_level_events" {
	targets = [{
		"__address__"      = "wazuh-findings-exporter.wazuh.svc:7979",
		"__metrics_path__" = "/probe",
		"__param_module"   = "wazuh_high_level_events",
		"__param_target"   = "https://wazuh-indexer.wazuh.svc:9200/wazuh-alerts-4.x-*/_search",
	}]

	forward_to      = [prometheus.relabel.wazuh_findings.receiver]
	job_name        = "wazuh-high-level-events"
	scrape_interval = "60s"
	scrape_timeout  = "15s"
}

// ---------------------------------------------------------------------------
// Logs
// ---------------------------------------------------------------------------

discovery.relabel "pod_logs" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		regex         = "(.+)"
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app"]
		regex         = "(.+)"
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_container_name"]
		regex         = "wazuh;(alerts-tail|ossec-log-tail|cti-freshness)"
		action        = "drop"
	}
}

loki.process "pod_logs" {
	forward_to = [loki.write.loki.receiver]

	// Loki rejects samples older than its reject_old_samples window.
	stage.drop {
		older_than          = "59m"
		drop_counter_reason = "too_old_for_loki"
	}
}

loki.source.kubernetes "pod_logs" {
	targets    = discovery.relabel.pod_logs.output
	forward_to = [loki.process.pod_logs.receiver]
}

discovery.relabel "wazuh_pod_logs" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_container_name"]
		regex         = "wazuh;wazuh-manager;(alerts-tail|ossec-log-tail|cti-freshness)"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		regex         = "alerts-tail"
		target_label  = "job"
		replacement   = "wazuh-alerts"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		regex         = "ossec-log-tail"
		target_label  = "job"
		replacement   = "wazuh-ossec-log"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		regex         = "cti-freshness"
		target_label  = "job"
		replacement   = "wazuh-cti-freshness"
	}
}

// Wazuh manager sidecars are collected only by this dedicated pipeline, which selects events
// before sending them to Loki and keeps the bounded label set.
loki.process "wazuh_pod_logs" {
	forward_to = [loki.write.loki.receiver]

	stage.match {
		selector = "{namespace=\"wazuh\", container=\"alerts-tail\"} |~ \"\\\"id\\\":\\\"2350[2-6]\\\"|\\\"level\\\":(1[2-9]|[2-9][0-9])\""
		action   = "keep"

		stage.json {
			expressions = {
				rule_id    = "rule.id",
				rule_level = "rule.level",
				status     = "data.vulnerability.status",
				severity   = "data.vulnerability.severity",
				timestamp  = "timestamp",
			}
		}

		stage.labels {
			values = {
				status   = "",
				severity = "",
			}
		}

		stage.timestamp {
			source            = "timestamp"
			format            = "2006-01-02T15:04:05.999999999-0700"
			action_on_failure = "skip"
		}
	}

	stage.match {
		selector = "{namespace=\"wazuh\", container=\"ossec-log-tail\"} |~ \"(?i)(ERROR|WARNING|CRITICAL|vulnerability|scanner|feed)\""
		action   = "keep"

		stage.regex {
			expression = `^(?P<timestamp>\d{4}/\d{2}/\d{2} \d{2}:\d{2}:\d{2}) (?P<component>[^ ]+) (?P<level>[^:]+): (?P<message>.*)$`
		}

		stage.timestamp {
			source            = "timestamp"
			format            = "2006/01/02 15:04:05"
			action_on_failure = "skip"
		}
	}

	stage.match {
		selector = `{namespace="wazuh", container="cti-freshness"}`

		stage.json {
			expressions = {timestamp = "timestamp"}
		}

		stage.timestamp {
			source            = "timestamp"
			format            = "RFC3339Nano"
			action_on_failure = "skip"
		}
	}
}

loki.source.kubernetes "wazuh_pod_logs" {
	targets    = discovery.relabel.wazuh_pod_logs.output
	forward_to = [loki.process.wazuh_pod_logs.receiver]
}

loki.source.kubernetes_events "cluster_events" {
	forward_to = [loki.write.loki.receiver]
	log_format = "logfmt"
}

// ---------------------------------------------------------------------------
// Syslog from the QNAP (QuLog Center, Log Sender, Send to Syslog Server)
// ---------------------------------------------------------------------------

// Only low-cardinality header fields become labels. The timestamp is the arrival time: an
// RFC 3164 timestamp has no year and no time zone, and Loki rejects samples that lie in its future.
loki.relabel "qnap_syslog" {
	forward_to = []

	rule {
		source_labels = ["__syslog_message_hostname"]
		target_label  = "host"
	}

	rule {
		source_labels = ["__syslog_message_app_name"]
		target_label  = "app"
	}

	rule {
		source_labels = ["__syslog_message_severity"]
		target_label  = "severity"
	}

	rule {
		source_labels = ["__syslog_message_facility"]
		target_label  = "facility"
	}

	rule {
		source_labels = ["__syslog_connection_ip_address"]
		target_label  = "source_ip"
	}
}

// One listener per format and protocol; the ports are published by the alloy-syslog service.
loki.source.syslog "qnap" {
	listener {
		address       = "0.0.0.0:SYSLOG_RFC5424_PORT"
		protocol      = "tcp"
		syslog_format = "rfc5424"
		labels        = {job = "qnap-syslog", source = "qnap"}
	}

	listener {
		address       = "0.0.0.0:SYSLOG_RFC5424_PORT"
		protocol      = "udp"
		syslog_format = "rfc5424"
		labels        = {job = "qnap-syslog", source = "qnap"}
	}

	listener {
		address       = "0.0.0.0:SYSLOG_RFC3164_PORT"
		protocol      = "tcp"
		syslog_format = "rfc3164"
		labels        = {job = "qnap-syslog", source = "qnap"}
	}

	listener {
		address       = "0.0.0.0:SYSLOG_RFC3164_PORT"
		protocol      = "udp"
		syslog_format = "rfc3164"
		labels        = {job = "qnap-syslog", source = "qnap"}
	}

	relabel_rules = loki.relabel.qnap_syslog.rules
	forward_to    = [loki.write.loki.receiver]
}

// ---------------------------------------------------------------------------
// Syslog from OPNsense (System, Settings, Logging, Remote; RFC 5424, ADR-0038)
// ---------------------------------------------------------------------------

loki.relabel "opnsense_syslog" {
	forward_to = []

	rule {
		source_labels = ["__syslog_message_hostname"]
		target_label  = "host"
	}

	rule {
		source_labels = ["__syslog_message_app_name"]
		target_label  = "app"
	}

	rule {
		source_labels = ["__syslog_message_severity"]
		target_label  = "severity"
	}

	rule {
		source_labels = ["__syslog_message_facility"]
		target_label  = "facility"
	}

	rule {
		source_labels = ["__syslog_connection_ip_address"]
		target_label  = "source_ip"
	}
}

loki.source.syslog "opnsense" {
	listener {
		address       = "0.0.0.0:OPNSENSE_SYSLOG_PORT"
		protocol      = "tcp"
		syslog_format = "rfc5424"
		labels        = {job = "opnsense-syslog", source = "opnsense"}
	}

	listener {
		address       = "0.0.0.0:OPNSENSE_SYSLOG_PORT"
		protocol      = "udp"
		syslog_format = "rfc5424"
		labels        = {job = "opnsense-syslog", source = "opnsense"}
	}

	relabel_rules = loki.relabel.opnsense_syslog.rules
	forward_to    = [loki.process.opnsense_syslog.receiver]
}

// Firewall log lines (filterlog) are CSV. Only low-cardinality fields become labels; addresses and
// ports are structured metadata, so they can be filtered and grouped without creating streams.
// Field positions: rule, sub-rule, anchor, rule id, interface, reason, action, direction, IP version;
// IPv4 continues with 7 fields before the protocol name, IPv6 with 3.
loki.process "opnsense_syslog" {
	forward_to = [loki.write.loki.receiver]

	stage.match {
		selector = `{app="filterlog"}`

		stage.regex {
			expression = `^[^,]*,[^,]*,[^,]*,(?P<rule>[^,]*),(?P<interface>[^,]*),[^,]*,(?P<action>[^,]*),(?P<direction>[^,]*),`
		}

		stage.labels {
			values = {interface = "", action = "", direction = ""}
		}

		stage.structured_metadata {
			values = {rule = ""}
		}
	}

	stage.match {
		selector = `{app="filterlog"} |~ "^([^,]*,){8}4,"`

		stage.regex {
			expression = `^(?:[^,]*,){8}4,(?:[^,]*,){7}(?P<proto>[^,]*),[^,]*,(?P<src>[^,]*),(?P<dst>[^,]*)`
		}

		stage.regex {
			expression = `^(?:[^,]*,){8}4,(?:[^,]*,){7}(?:tcp|udp),(?:[^,]*,){3}(?P<src_port>\d+),(?P<dst_port>\d+)`
		}

		stage.structured_metadata {
			values = {proto = "", src = "", dst = "", src_port = "", dst_port = ""}
		}
	}

	stage.match {
		selector = `{app="filterlog"} |~ "^([^,]*,){8}6,"`

		stage.regex {
			expression = `^(?:[^,]*,){8}6,(?:[^,]*,){3}(?P<proto>[^,]*),[^,]*,[^,]*,(?P<src>[^,]*),(?P<dst>[^,]*)`
		}

		stage.regex {
			expression = `^(?:[^,]*,){8}6,(?:[^,]*,){3}(?:tcp|udp),(?:[^,]*,){4}(?P<src_port>\d+),(?P<dst_port>\d+)`
		}

		stage.structured_metadata {
			values = {proto = "", src = "", dst = "", src_port = "", dst_port = ""}
		}
	}
}

// ---------------------------------------------------------------------------
// Probes and scrapes of external targets
// ---------------------------------------------------------------------------

// The targets live in a 1Password Secret mounted at TARGETS_PATH (see targets.py); discovery.file
// re-reads a changed file without a restart.
discovery.file "probe_targets" {
	files = ["TARGETS_PATH/blackbox-targets.json"]
}

// The effective timeout of a probe is capped at 10 seconds in the embedded exporter.
prometheus.exporter.blackbox "probes" {
	config = `
modules:
  http_2xx:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
  tcp_connect:
    prober: tcp
    timeout: 10s
  icmp:
    prober: icmp
    timeout: 5s
    icmp:
      preferred_ip_protocol: ip4
`
	targets = discovery.file.probe_targets.targets
}

// `instance` is the probed address and the job names are those of the legacy Prometheus, because
// the migrated alert rules and dashboards select on them.
discovery.relabel "probes" {
	targets = prometheus.exporter.blackbox.probes.targets

	rule {
		source_labels = ["__param_target"]
		target_label  = "instance"
	}

	rule {
		source_labels = ["group"]
		regex         = "http"
		target_label  = "job"
		replacement   = "blackbox"
	}

	rule {
		source_labels = ["group"]
		regex         = "slow"
		target_label  = "job"
		replacement   = "blackbox-slow"
	}

	rule {
		source_labels = ["group"]
		regex         = "icmp"
		target_label  = "job"
		replacement   = "blackbox-icmp"
	}

	rule {
		source_labels = ["group"]
		regex         = "tcp"
		target_label  = "job"
		replacement   = "blackbox-tcp"
	}
}

discovery.relabel "probes_fast" {
	targets = discovery.relabel.probes.output

	rule {
		source_labels = ["group"]
		regex         = "http|icmp|tcp"
		action        = "keep"
	}
}

discovery.relabel "probes_slow" {
	targets = discovery.relabel.probes.output

	rule {
		source_labels = ["group"]
		regex         = "slow"
		action        = "keep"
	}
}

prometheus.scrape "probes_fast" {
	targets         = discovery.relabel.probes_fast.output
	forward_to      = [prometheus.remote_write.mimir.receiver]
	scrape_interval = "60s"
	scrape_timeout  = "20s"
}

prometheus.scrape "probes_slow" {
	targets         = discovery.relabel.probes_slow.output
	forward_to      = [prometheus.remote_write.mimir.receiver]
	scrape_interval = "120s"
	scrape_timeout  = "20s"
}

// AX51 (node exporter, Docker metrics, cAdvisor) and Pretix publish metrics over HTTPS with basic auth.
// The credential files are polled instead of watched: every inotify watcher counts against a
// per-user limit that the node shares between k0s, the kubelet, containerd and all root pods.
local.file "ax51_username" {
	filename       = "TARGETS_PATH/ax51-username"
	detector       = "poll"
	poll_frequency = "1m"
}

local.file "ax51_password" {
	filename       = "TARGETS_PATH/ax51-password"
	detector       = "poll"
	poll_frequency = "1m"
	is_secret      = true
}

discovery.file "ax51" {
	files = ["TARGETS_PATH/ax51-targets.json"]
}

// cAdvisor turns every Docker label of a container into a `container_label_*` label. The AX51
// containers carry 20 and more of them (Compose, Traefik, Watchtower), which pushed some series over
// Mimir's limit of 30 label names per series (`err-mimir-max-label-names-per-series`, 2026-10-17).
// Mimir rejects such a series with a 400 and Alloy drops the whole batch of 2,000 samples, so about
// 1% of all samples were lost. Only the Compose project survives, as `stack` (the container name
// for containers without Compose); `name`, `image` and `id` stay.
prometheus.relabel "ax51" {
	forward_to = [prometheus.remote_write.mimir.receiver]

	rule {
		source_labels = ["container_label_com_docker_compose_project"]
		target_label  = "stack"
	}

	// Containers started without Compose are their own stack.
	rule {
		source_labels = ["stack", "name"]
		regex         = ";(.+)"
		target_label  = "stack"
	}

	rule {
		regex  = "container_label_.+"
		action = "labeldrop"
	}
}

prometheus.scrape "ax51" {
	targets    = discovery.file.ax51.targets
	forward_to = [prometheus.relabel.ax51.receiver]
	// The default job name is the component name; the dashboards and rules use the legacy one.
	job_name        = "ax51"
	scheme          = "https"
	scrape_interval = "30s"

	basic_auth {
		username = local.file.ax51_username.content
		password = local.file.ax51_password.content
	}
}

local.file "pretix_username" {
	filename       = "TARGETS_PATH/pretix-username"
	detector       = "poll"
	poll_frequency = "1m"
}

local.file "pretix_password" {
	filename       = "TARGETS_PATH/pretix-password"
	detector       = "poll"
	poll_frequency = "1m"
	is_secret      = true
}

discovery.file "pretix" {
	files = ["TARGETS_PATH/pretix-targets.json"]
}

prometheus.scrape "pretix" {
	targets    = discovery.file.pretix.targets
	forward_to = [prometheus.remote_write.mimir.receiver]
	// The default job name is the component name; the dashboards and rules use the legacy one.
	job_name        = "pretix"
	scheme          = "https"
	scrape_interval = "60s"
	// Pretix needs the explicit text format, as it did on the legacy Prometheus.
	scrape_protocols = ["PrometheusText1.0.0", "PrometheusText0.0.4"]

	basic_auth {
		username = local.file.pretix_username.content
		password = local.file.pretix_password.content
	}
}

// ---------------------------------------------------------------------------
// Internet speed test
// ---------------------------------------------------------------------------

// Every scrape of /probe runs one real speed test of 15 to 100 seconds, so the interval is long (the
// legacy script ran every 30 minutes too) and the timeout leaves room for a slow test.
prometheus.scrape "speedtest" {
	targets         = [{"__address__" = "speedtest-exporter.observability.svc:9469"}]
	forward_to      = [prometheus.remote_write.mimir.receiver]
	job_name        = "speedtest"
	metrics_path    = "/probe"
	params          = {"script" = ["speedtest"]}
	scrape_interval = "30m"
	scrape_timeout  = "3m"
}

// ---------------------------------------------------------------------------
// Tandoor
// ---------------------------------------------------------------------------

// django-prometheus serves /metrics on the application port; the ingress does not route it. Tandoor
// 2.7.1 serves it only to a signed-in user, so Alloy sends the session cookie of the space-less user
// tandoor-metrics (ADR-0035). The Service name is one of Tandoor's allowed hosts (ALLOWED_HOSTS).
local.file "tandoor_cookie" {
	filename       = "TARGETS_PATH/tandoor-cookie"
	detector       = "poll"
	poll_frequency = "1m"
	is_secret      = true
}

prometheus.scrape "tandoor" {
	targets         = [{"__address__" = "tandoor.tandoor.svc:80"}]
	forward_to      = [prometheus.remote_write.mimir.receiver]
	job_name        = "tandoor"
	scrape_interval = "30s"
	scrape_timeout  = "10s"
	http_headers    = {"Cookie" = [local.file.tandoor_cookie.content]}
	// An expired session then fails as HTTP 302 instead of as an unparsable login page.
	follow_redirects = false
}

// ---------------------------------------------------------------------------
// NetBox
// ---------------------------------------------------------------------------

// NetBox serves /metrics on the application port, without authentication, so the ingress does not
// route it. The Service name is one of NetBox's allowed hosts (allowedHosts in the chart values).
prometheus.scrape "netbox" {
	targets         = [{"__address__" = "netbox.netbox.svc:80"}]
	forward_to      = [prometheus.remote_write.mimir.receiver]
	job_name        = "netbox"
	scrape_interval = "30s"
	scrape_timeout  = "10s"
}

// ---------------------------------------------------------------------------
// OPNsense (ADR-0038)
// ---------------------------------------------------------------------------

// The API exporter (opnsense.py) calls about a dozen API endpoints per scrape.
prometheus.scrape "opnsense" {
	targets         = [{"__address__" = "opnsense-exporter.observability.svc:8080", "instance" = "opnsense"}]
	forward_to      = [prometheus.remote_write.mimir.receiver]
	job_name        = "opnsense"
	scrape_interval = "60s"
	scrape_timeout  = "30s"
}

// os-node_exporter plugin on the firewall (FreeBSD metric names, e.g. no MemAvailable).
prometheus.scrape "opnsense_node" {
	targets         = [{"__address__" = "OPNSENSE_NODE_EXPORTER_TARGET", "instance" = "opnsense"}]
	forward_to      = [prometheus.remote_write.mimir.receiver]
	job_name        = "opnsense-node"
	scrape_interval = "30s"
	scrape_timeout  = "10s"
}
