#!/usr/bin/env bash
# Validates .okf with the APM-managed okf-validate skill (not tracked, see .gitignore).
set -eu

cd "$(git rev-parse --show-toplevel)"

script=.agents/skills/okf-validate/scripts/okf_validate.py
if [ ! -f "$script" ]; then
  echo "okf-validate: $script missing, run: apm install" >&2
  exit 1
fi

exec uv run --with pyyaml python "$script" .okf
